# Hermes Life — host (controller) settings for this NUC.
#
# Loaded automatically by ./start.sh, before the worker configuration. These are paths that belong to
# the controller itself (the machine running the backend), not to the coding worker.
#
# The Obsidian vault lives on the external disk labelled "black". After the OS migration that disk is
# mounted by udisks2 under /run/media/<user>/black (it used to be reachable at $HOME/black), so the
# pre-migration default in the code no longer resolves. Point the mirror at the vault root — the folder
# that contains `.obsidian/` and `Hermes-Life/`.
#
# Overridable: set HERMES_LIFE_HOST_ENV to source a different file (tests, throwaway setups).
export HERMES_LIFE_OBSIDIAN_VAULT=/run/media/gayzer/black/obsidian/hermes

# HL-CHAT-006: project registration roots. ~/Apps is always allowed; extra roots
# (colon-separated) extend where the Conversations "Register" panel may point —
# e.g. repositories outside the Apps folder. Registration still requires a Git
# repository root, and file access stays bounded to the registered project.
export HERMES_LIFE_PROJECT_EXTRA_ROOTS='/home/gayzer:/run/media/gayzer/black'

# HL-AUTH-001: password-protected entrance for the public dev deployment
# (dev.hermeshaplease.com). The gate is OFF unless this hash is set.
# Entrance image served by the backend at /api/entrance/image.
export HERMES_LIFE_GATE_IMAGE='/hermes-life/Hermetic Celestial Alchemy Doors-2.png'
# HL-AUTH-002: WebAuthn passkey unlock. RP ID / origin defaults already match
# dev.hermeshaplease.com; this points at the single credential file. Enrol via
# the chat header "Passkey" button after unlocking with the password.

# HL-CHAT-004: interactive model catalog for Chat. Context windows verified against
# OpenRouter's public model catalog (2026-11-21). Backend validates per-task at POST time.
export HERMES_LIFE_CHAT_MODELS='[
  {"provider":"openrouter","model":"z-ai/glm-5.3-flash","label":"GLM 5.3 Flash (default)","context_window":1048576},
  {"provider":"openrouter","model":"deepseek/deepseek-v3.2","label":"DeepSeek V3.2","context_window":163840},
  {"provider":"openrouter","model":"google/gemini-2.5-flash","label":"Gemini 2.5 Flash","context_window":1048576},
  {"provider":"openrouter","model":"anthropic/claude-sonnet-4.5","label":"Claude Sonnet 4.5","context_window":1000000}
]'

# HL-CHAT-004 §2.6: provider balance. Key flows from your shell env — never stored in this repo.
# Credentials are NOT stored here: they live in $HOME/.config/hermes-life/keys.env,
# which this file sources below (outside the shared project, mode 0600).
# Put the key in ~/.config/hermes-life/keys.env (sourced below) or export OPENROUTER_API_KEY in the
# shell before start.sh runs. If missing, the chat header shows "Balance not configured".
if [ -f "$HOME/.config/hermes-life/keys.env" ]; then
  . "$HOME/.config/hermes-life/keys.env"
fi
