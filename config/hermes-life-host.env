# Hermes Life — host (controller) settings for this NUC.
#
# Loaded automatically by ./start.sh, before the worker configuration. These are paths that belong to
# the controller itself (the machine running the backend), not to the coding worker.
#
# The Obsidian vault lives on the external disk labelled "black". After the OS migration that disk is
# mounted by udisks2 under /run/media/<user>/black (it used to be reachable at $HOME/black), so the
# pre-migration default in the code no longer resolves. Point the mirror at the vault root — the folder
# that contains `.obsidian/` and `Hermes-Life/`.
#
# Overridable: set HERMES_LIFE_HOST_ENV to source a different file (tests, throwaway setups).
export HERMES_LIFE_OBSIDIAN_VAULT=/run/media/gayzer/black/obsidian/hermes
