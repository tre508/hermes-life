# Hermes Life — the coding worker: Lenovo laptop (glenn-mem). THIS IS THE ONLY WORKER.
#
# Loaded automatically by ./start.sh. To start the backend by hand:
#     source config/hermes-life-lenovo.env && ./start.sh
#
# Split of responsibilities (HL-WORKER):
#   this NUC   = FastAPI backend, web UI, SQLite, memory, Obsidian vault, scheduling, orchestration
#   the worker = Hermes Agent runs, project workspaces, candidate builds, tests, evaluations, revisions
#
# Worker: glenn-mem (Lenovo, Intel i3-1005G1, 8 GB RAM) — LAN 192.168.178.37, Tailscale 100.82.210.26
# The retired Kubuntu VM is decommissioned: nothing here may point at it, and no code carries its
# address or key as a default, so it can be powered off permanently.
export HERMES_LIFE_TRANSPORT=ssh
export HERMES_LIFE_VM_HOST=192.168.178.37
export HERMES_LIFE_VM_USER=glenn
export HERMES_LIFE_VM_PORT=22
export HERMES_LIFE_VM_KEY="$HOME/.ssh/hermes-lenovo"

# The worker's own home. Every guest script, prompt and workspace path is derived from this, so the
# whole pipeline executes against /home/glenn/... directly and needs no compatibility symlink.
export HERMES_LIFE_GUEST_HOME=/home/glenn

# Optional overrides — these defaults are derived from HERMES_LIFE_GUEST_HOME above.
# export HERMES_LIFE_GUEST_HERMES=/home/glenn/.local/bin/hermes
# export HERMES_LIFE_TIMEOUT=1800
