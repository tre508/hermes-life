# Lenovo worker transport for the hermes-life backend (read by start.sh).
# Without this file the backend defaults to local transport, looks for the Hermes
# CLI on its own PATH, and every chat send fails with HTTP 503 "Hermes CLI unavailable".
HERMES_LIFE_TRANSPORT=ssh
HERMES_LIFE_VM_HOST=192.168.178.37
HERMES_LIFE_VM_USER=glenn
HERMES_LIFE_VM_PORT=22
HERMES_LIFE_VM_KEY=/home/gayzer/.ssh/hermes-lenovo
HERMES_LIFE_GUEST_HOME=/home/glenn
