#!/usr/bin/env python3
"""Capture a reproducible full-page browser screenshot of a RUNNING UI.

Requires a local Chromium/Chrome binary with headless support. Captures are not
accepted as evidence if the local development server cannot be reached.
"""
from __future__ import annotations
import argparse
from pathlib import Path
import shutil
import subprocess
import tempfile
import urllib.request

def main():
    ap=argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--url',default='http://127.0.0.1:5173/')
    ap.add_argument('--output',type=Path,default=Path('phase6-reports/live-ui.png'))
    ap.add_argument('--width',type=int,default=1600);ap.add_argument('--height',type=int,default=1000)
    args=ap.parse_args()
    try:
        with urllib.request.urlopen(args.url,timeout=5) as response:
            if response.status >= 400:raise RuntimeError(f'HTTP {response.status}')
    except Exception as exc:
        raise SystemExit(f'Frontend server is not reachable at {args.url}: {exc}')
    binary=next((shutil.which(b) for b in ('chromium','chromium-browser','google-chrome','google-chrome-stable','brave-browser') if shutil.which(b)),None)
    if not binary:raise SystemExit('Chromium-compatible browser binary not found on PATH.')
    args.output=args.output.resolve();args.output.parent.mkdir(parents=True,exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='hermesha-capture-') as profile:
        command=[binary,'--headless=new','--disable-gpu-sandbox','--no-first-run',f'--user-data-dir={profile}',
                 '--hide-scrollbars','--virtual-time-budget=10000',f'--window-size={args.width},{args.height}',
                 f'--screenshot={args.output}',args.url]
        result=subprocess.run(command,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=45)
    if result.returncode or not args.output.is_file():
        raise SystemExit('Browser screenshot failed: '+result.stderr[-1500:])
    print('Captured:',args.output)
if __name__=='__main__':main()
