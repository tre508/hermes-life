import Phaser from 'phaser';
import './style.css';

type EventRecord = {sequence:number; id:string; task_id:string|null; type:string;timestamp:string;payload:Record<string,unknown>};
type WorldState = {room:string;activity:string;agent_x:number;agent_y:number;last_sequence:number};
const mapRooms = [
  {id:'control',label:'CONTROL',x:14,y:15,description:'Selecting goals and planning tasks.'},
  {id:'library',label:'LIBRARY',x:282,y:15,description:'Reviewing context and knowledge.'},
  {id:'workshop',label:'WORKSHOP',x:550,y:15,description:'Coding and using Hermes tools.'},
  {id:'archive',label:'ARCHIVE',x:14,y:220,description:'Recording results and experiences.'},
  {id:'laboratory',label:'LABORATORY',x:282,y:220,description:'Evaluating output and tool results.'},
  {id:'rest',label:'REST',x:550,y:220,description:'Waiting for work.'}
] as const;
type RoomId = typeof mapRooms[number]['id'];
const centers = Object.fromEntries(mapRooms.map(r=>[r.id,{x:r.x+108,y:r.y+68}])) as Record<RoomId,{x:number,y:number}>;
const $ = (id:string) => document.getElementById(id)!;
let selectedTask:string|null = null;
let lastSequence = 0;
let scene:WorldScene;
type TaskRecord = {id:string;prompt:string;state:string;result:string|null;error:string|null;session_id:string|null;created_at:string};
let viewedTaskId:string|null=null;
let followLive=true;
function setFollowLive(enabled:boolean){
  followLive=enabled;
  const button=$('response-follow');
  button.textContent=enabled?'Following live':'Follow live';
  button.setAttribute('aria-pressed',String(enabled));
  $('response-source').textContent=enabled?'Latest agent activity':'History selection';
}
$('response-follow').addEventListener('click',()=>{setFollowLive(true);void syncLatestTask();});
let pendingRefresh:ReturnType<typeof setTimeout>|undefined;
let requestGeneration=0;
let currentAnswer = '';
function renderAnswer(source:string){
  currentAnswer=source;
  $('response-text').textContent=source;
  const root=$('response-rich');root.replaceChildren();
  const lines=source.replace(/\r\n/g,'\n').split('\n');
  let i=0;
  const addInline=(el:HTMLElement,value:string)=>{
    const pattern=/(`[^`\n]+`|\*\*[^*\n]+\*\*)/g;let pos=0;let match:RegExpExecArray|null;
    while((match=pattern.exec(value))!==null){
      if(match.index>pos)el.append(document.createTextNode(value.slice(pos,match.index)));
      const raw=match[0];const item=document.createElement(raw.startsWith('`')?'code':'strong');
      item.textContent=raw.startsWith('`')?raw.slice(1,-1):raw.slice(2,-2);el.append(item);pos=pattern.lastIndex;
    }
    if(pos<value.length)el.append(document.createTextNode(value.slice(pos)));
  };
  while(i<lines.length){
    const line=lines[i];if(!line.trim()){i++;continue;}
    if(/^\s*```/.test(line)){
      const code=document.createElement('pre');code.className='answer-code';i++;
      const block:string[]=[];while(i<lines.length&&!/^\s*```/.test(lines[i]))block.push(lines[i++]);
      if(i<lines.length)i++;const inner=document.createElement('code');inner.textContent=block.join('\n');code.append(inner);root.append(code);continue;
    }
    const heading=line.match(/^\s{0,3}(#{1,4})\s+(.+)/);
    if(heading){const el=document.createElement(heading[1].length<=2?'h3':'h4');addInline(el,heading[2]);root.append(el);i++;continue;}
    if(/^\s*[-*]\s+/.test(line)||/^\s*\d+[.)]\s+/.test(line)){
      const ordered=/^\s*\d+[.)]\s+/.test(line);const list=document.createElement(ordered?'ol':'ul');
      while(i<lines.length&&(ordered?/^\s*\d+[.)]\s+/:/^\s*[-*]\s+/).test(lines[i])){
        const li=document.createElement('li');addInline(li,lines[i].replace(ordered?/^\s*\d+[.)]\s+/:/^\s*[-*]\s+/,''));list.append(li);i++;
      }root.append(list);continue;
    }
    if(/^\s*---+\s*$/.test(line)){root.append(document.createElement('hr'));i++;continue;}
    const block:string[]=[line.trim()];i++;
    while(i<lines.length&&lines[i].trim()&&!/^(\s*```|\s{0,3}#{1,4}\s|\s*[-*]\s+|\s*\d+[.)]\s+)/.test(lines[i]))block.push(lines[i++].trim());
    const para=document.createElement('p');addInline(para,block.join(' '));root.append(para);
  }
  if(!root.children.length){const p=document.createElement('p');p.textContent='No response available.';root.append(p);}
}
function setResponseTab(tab:string){
  for(const name of ['answer','tools','history']){
    const selected=name===tab;
    $(`response-${name==='answer'?'answer':name==='tools'?'tools':'history'}-panel`).hidden=!selected;
    const btn=document.querySelector<HTMLButtonElement>(`[data-response-tab="${name}"]`);
    if(btn){btn.classList.toggle('active',selected);btn.setAttribute('aria-selected',String(selected));}
  }
}
document.querySelectorAll<HTMLButtonElement>('[data-response-tab]').forEach(b=>b.addEventListener('click',()=>setResponseTab(b.dataset.responseTab||'answer')));
$('response-raw-toggle').addEventListener('change',()=>{
  const checked=( $('response-raw-toggle') as HTMLInputElement).checked;
  $('response-text').hidden=!checked;$('response-rich').hidden=checked;
});
$('response-copy').addEventListener('click',()=>void navigator.clipboard.writeText(currentAnswer));
$('response-expand').addEventListener('click',()=>{
  const expanded=$('response-workspace').classList.toggle('expanded');
  $('response-expand').textContent=expanded?'Collapse':'Expand';
});

const toolEntries=new Map<string,EventRecord[]>();
function describePayload(payload:Record<string,unknown>):string{
  try{return JSON.stringify(payload,null,2)}catch{return String(payload)}
}
function renderTools(id:string){
  const container=$('tool-events');container.replaceChildren();
  const entries=toolEntries.get(id)||[];
  $('tool-count').textContent=String(entries.length);
  for(const evt of entries){
    const div=document.createElement('div');div.className='tool-entry';
    const heading=document.createElement('strong');heading.textContent=evt.type;
    const value=document.createElement('span');value.textContent=describePayload(evt.payload);
    div.append(heading,value);container.append(div);
  }
}
async function loadTask(id:string){
  viewedTaskId=id;
  const generation=++requestGeneration;
  $('response-id').textContent=id;
  try{
    const response=await fetch(`/api/tasks/${encodeURIComponent(id)}`);
    if(!response.ok)throw new Error(`HTTP ${response.status}`);
    const task=await response.json() as TaskRecord;
    if(generation!==requestGeneration)return;
    $('response-status').textContent=task.state;
    renderAnswer(task.result ?? (task.state==='failed'?'Task failed without a response.':task.state==='completed'?'Task completed without response text.':'Hermes is working; awaiting response…')); 
    const error=$('response-error');error.hidden=!task.error;error.textContent=task.error||'';
    renderTools(id);
    document.querySelectorAll<HTMLButtonElement>('.history-entry').forEach(btn=>btn.setAttribute('aria-current',String(btn.dataset.taskId===id)));
  }catch(err){if(generation===requestGeneration)$('response-status').textContent=`Cannot load: ${String(err)}`}
}
async function refreshHistory(){
  try{
    const response=await fetch('/api/tasks');if(!response.ok)throw new Error(`HTTP ${response.status}`);
    const tasks=await response.json() as TaskRecord[];
    const list=$('task-history');list.replaceChildren();
    if(!tasks.length)list.textContent='No previous tasks.';
    for(const task of tasks){
      const btn=document.createElement('button');btn.type='button';btn.className='history-entry';btn.dataset.taskId=task.id;
      btn.setAttribute('aria-current',String(task.id===viewedTaskId));
      const state=document.createElement('span');state.className='state';state.textContent=task.state;
      const prompt=document.createElement('span');prompt.textContent=task.prompt.length>90?task.prompt.slice(0,90)+'…':task.prompt;
      const date=document.createElement('small');date.textContent=new Date(task.created_at).toLocaleString()+' · '+task.id.slice(0,8);
      btn.append(state,prompt,date);btn.addEventListener('click',()=>{setFollowLive(false);setResponseTab('answer');void loadTask(task.id);});list.append(btn);
    }
    // The response panel follows real task activity, never a generic history selection.
    if(!viewedTaskId) { $('response-status').textContent='No task observed'; $('response-id').textContent='—'; }
  }catch(err){$('task-history').textContent=`History unavailable: ${String(err)}`}
}
function scheduleTaskRefresh(evt:EventRecord){
  if(!evt.task_id)return;
  // Autonomous goal tasks also generate task.* events; follow those like manual submissions.
  if(followLive && (evt.type==='task.queued'||evt.type==='task.started'||evt.type==='task.completed'||evt.type==='task.failed')){
    if(viewedTaskId!==evt.task_id) {setResponseTab('answer');void loadTask(evt.task_id);}
  }
  if(evt.type==='hermes.tool_use'||evt.type==='hermes.tool_result'){
    const existing=toolEntries.get(evt.task_id)||[];
    existing.push(evt);toolEntries.set(evt.task_id,existing);
    if(viewedTaskId===evt.task_id)renderTools(evt.task_id);
  }
  if(viewedTaskId===evt.task_id && (evt.type==='task.started'||evt.type==='task.completed'||evt.type==='task.failed')){
    // Completion event is emitted after the task record is updated.
    clearTimeout(pendingRefresh);pendingRefresh=setTimeout(()=>void loadTask(evt.task_id!),100);
  }
  if(evt.type.startsWith('goal.')||evt.type.startsWith('autonomy.')){void refreshGoals()}
  if(evt.type.startsWith('discovery.')){void refreshDiscoveries()}
  if(evt.type.startsWith('formulation.')){void refreshFormulations()}
  if(evt.type==='task.queued'||evt.type==='task.completed'||evt.type==='task.failed'){
    void refreshHistory();
  }
}


function appendEvent(evt:EventRecord){
  if(evt.sequence <= lastSequence) return;
  lastSequence = evt.sequence;
  if(evt.task_id){ selectedTask = evt.task_id; latestEventTaskId=evt.task_id; }
  scheduleTaskRefresh(evt);
  const item=document.createElement('div');item.className='event';
  const title=document.createElement('span');title.textContent=`#${evt.sequence}  ${evt.type}`;
  const details=document.createElement('em');details.textContent=new Date(evt.timestamp).toLocaleTimeString()+' · '+(evt.task_id||'system');
  item.append(title,details);$('events').prepend(item);
  while($('events').childElementCount>100) $('events').lastElementChild?.remove();
  $('task').textContent=selectedTask?.slice(0,8)||'—';
  // The visual projection is never interpreted as task completion; backend remains authoritative.
  const room = evt.type==='goal.selected'||evt.type==='autonomy.resumed'?'control':evt.type==='task.queued'?'control':evt.type==='task.started'||evt.type==='hermes.tool_use'?'workshop':evt.type==='hermes.system'?'library':evt.type==='hermes.tool_result'||evt.type==='hermes.result'?'laboratory':evt.type==='task.completed'||evt.type==='task.failed'?'archive':null;
  if(room && scene){ const activity=evt.type==='task.completed'?'recording':evt.type==='task.failed'?'failed':evt.type==='task.queued'?'planning':evt.type==='hermes.system'?'researching':evt.type==='hermes.result'?'evaluating':evt.type==='hermes.tool_result'?'reviewing':'coding';scene.moveTo(room,activity); }
}
class WorldScene extends Phaser.Scene {
  private hero!:Phaser.GameObjects.Container;
  private motion?:Phaser.Tweens.Tween;
  private room:RoomId='rest';
  constructor(){super('WorldScene')}
  create(){
    const g=this.add.graphics();
    g.fillStyle(0x192e3a);g.fillRect(0,0,800,425);
    for(let y=0;y<425;y+=16){for(let x=0;x<800;x+=16){g.fillStyle((x+y)%32===0?0x233b46:0x203641);g.fillRect(x+1,y+1,14,14)}}
    for(const r of mapRooms){
      g.fillStyle(0x395866);g.fillRoundedRect(r.x,r.y,235,172,6);
      g.fillStyle(r.id==='workshop'?0x305f65:r.id==='laboratory'?0x615176:r.id==='rest'?0x4b6359:0x2d4855);g.fillRect(r.x+5,r.y+5,225,162);
      g.fillStyle(0x142632);g.fillRect(r.x+29,r.y+27,83,58);
      g.fillStyle(0x84c9bb);g.fillRect(r.x+36,r.y+34,69,39);
      g.fillStyle(0x294656);g.fillRect(r.x+42,r.y+40,57,27);
      g.fillStyle(0x9be8c4);g.fillRect(r.x+47,r.y+46,30,4);
      g.fillStyle(0x587887);g.fillRect(r.x+47,r.y+56,44,3);
      g.fillStyle(0x132833);g.fillRect(r.x+30,r.y+98,124,14);
      g.fillStyle(0x618491);g.fillRect(r.x+36,r.y+113,112,25);
      this.add.text(r.x+118,r.y+150,r.label,{fontFamily:'monospace',fontSize:'12px',color:'#cce8e1'}).setOrigin(.5);
      const zone=this.add.zone(r.x+117,r.y+86,235,172).setInteractive({useHandCursor:true});
      zone.on('pointerdown',()=>{$('room-info').textContent=`${r.label}: ${r.description}`;});
    }
    this.hero=this.add.container(0,0);
    const h=this.add.graphics();
    h.fillStyle(0x9fd6d3);h.fillRect(-11,-16,22,22);h.fillStyle(0x163846);h.fillRect(-8,-11,16,12);
    h.fillStyle(0x8af5b9);h.fillRect(-5,-7,3,3);h.fillRect(3,-7,3,3);
    h.fillStyle(0xa3b8cb);h.fillRect(-11,7,22,13);h.fillStyle(0x657a91);h.fillRect(-8,20,6,6);h.fillRect(2,20,6,6);
    this.hero.add(h);this.hero.setDepth(10);
    this.hero.setPosition(centers.rest.x,centers.rest.y);
    this.add.text(8,406,'HERMES LIFE • LIVE EVENTS',{fontFamily:'monospace',fontSize:'10px',color:'#a1c9c5'});
    scene=this;
    void hydrate();
  }
  moveTo(roomName:string, activity:string, immediate=false){
    if(!(roomName in centers))return;
    const room=roomName as RoomId;
    this.room=room;
    $('room').textContent=room.toUpperCase();$('activity').textContent=activity;
    this.motion?.stop();const to=centers[room];
    if(immediate){this.hero.setPosition(to.x,to.y);return;}
    this.motion=this.tweens.add({targets:this.hero,x:to.x,y:to.y,duration:650,ease:'Sine.easeInOut'});
  }
}
new Phaser.Game({type:Phaser.AUTO,parent:'game',width:800,height:425,backgroundColor:'#142734',pixelArt:true,scale:{mode:Phaser.Scale.FIT,autoCenter:Phaser.Scale.CENTER_HORIZONTALLY},scene:[WorldScene]});
async function hydrate(){
  try {
    const state = await fetch('/api/world/state').then(r=>{if(!r.ok)throw Error('API offline');return r.json() as Promise<WorldState>});
    scene.moveTo(state.room,state.activity,true);
    // Load an initial history slice and replay chronological events, then stream after the last received cursor.
    const history = await fetch('/api/events?after=0&limit=500').then(r=>r.json() as Promise<EventRecord[]>);
    for(const event of history){ appendHistorical(event); }
    scene.moveTo(state.room,state.activity,true);
    await refreshHistory();
    await syncLatestTask();
    connect();
  } catch(e){$('connection').textContent='API unavailable — retrying';setTimeout(hydrate,3000)}
}
function appendHistorical(evt:EventRecord){
  if(evt.sequence<=lastSequence)return;
  lastSequence=evt.sequence;
  if(evt.task_id && evt.type.startsWith('task.'))latestEventTaskId=evt.task_id;
  const item=document.createElement('div'); item.className='event';
  const title=document.createElement('span');title.textContent=`#${evt.sequence}  ${evt.type}`;
  const details=document.createElement('em');details.textContent=new Date(evt.timestamp).toLocaleTimeString()+' · '+(evt.task_id||'system');
  item.append(title,details);$('events').prepend(item);
  while($('events').childElementCount>100)$('events').lastElementChild?.remove();
  if(evt.task_id && (evt.type==='hermes.tool_use'||evt.type==='hermes.tool_result')){
    const entries=toolEntries.get(evt.task_id)||[];entries.push(evt);toolEntries.set(evt.task_id,entries);
  }
}
async function syncLatestTask(){
  if(!followLive)return;
  try{
    const stateResponse=await fetch('/api/agent/state');
    if(stateResponse.ok){
      const state=await stateResponse.json() as {current_task?:string|null};
      if(state.current_task){await loadTask(state.current_task);return;}
    }
    // On reconnect/reload show the latest *recorded activity* clearly labeled,
    // not an arbitrary task selected from the history list.
    if(latestEventTaskId){await loadTask(latestEventTaskId);}
  }catch(err){console.warn('Unable to synchronize latest task',err)}
}
let latestEventTaskId:string|null=null;
let socket:WebSocket|null=null;let retryDelay=1000;
function connect(){
  socket?.close();
  const protocol=location.protocol==='https:'?'wss':'ws';
  const ws=new WebSocket(`${protocol}://${location.host}/ws/events?after=${lastSequence}`);socket=ws;
  ws.onopen=()=>{$('connection').textContent='● LIVE';$('connection').style.color='#87e7ba';retryDelay=1000};
  ws.onmessage=e=>{try{appendEvent(JSON.parse(e.data) as EventRecord)}catch(err){console.error('Malformed event',err)}};
  ws.onclose=()=>{if(socket!==ws)return;$('connection').textContent='● Reconnecting';$('connection').style.color='#f1ba79';setTimeout(connect,retryDelay);retryDelay=Math.min(retryDelay*2,15000)};
  ws.onerror=()=>ws.close();
}
$('task-form').addEventListener('submit',async e=>{
  e.preventDefault();const prompt=($('prompt') as HTMLTextAreaElement).value.trim();if(!prompt)return;
  try{
    const response=await fetch('/api/tasks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt})});
    const body=await response.json();if(!response.ok)throw Error(body.detail||response.statusText);
    $('task-feedback').textContent=`Task accepted: ${body.id}`;($('prompt') as HTMLTextAreaElement).value='';
    setFollowLive(true);void loadTask(body.id);void refreshHistory();
  }catch(error){$('task-feedback').textContent=String(error)}
});

$('refresh-history').addEventListener('click',()=>void refreshHistory());
// Status polling handles missed WebSocket messages and task updates after disconnection.
setInterval(()=>{if(viewedTaskId && ['queued','running'].includes($('response-status').textContent||''))void loadTask(viewedTaskId)},3000);

// Phase 3: persistent, explicitly approved goals and a backend-owned scheduler.
type Goal = {id:string;title:string;prompt:string;priority:number;state:string;task_id:string|null;error:string|null};
let autonomyEnabled=false;
async function apiJSON(url:string, init?:RequestInit):Promise<any>{
  const response=await fetch(url,init);
  const raw=await response.text();
  let body:any;
  try{body=raw?JSON.parse(raw):null}catch{throw Error(`Invalid API response (HTTP ${response.status})`)}
  if(!response.ok)throw Error(body?.detail||`HTTP ${response.status}`);
  return body;
}
async function refreshGoals(){
  try{
    const state=await apiJSON('/api/autonomy') as {enabled:boolean};autonomyEnabled=state.enabled;
    $('autonomy-status').textContent=autonomyEnabled?'ENABLED':'PAUSED';
    $('autonomy-toggle').textContent=autonomyEnabled?'Pause autonomy':'Enable autonomy';
    const goals=await apiJSON('/api/goals') as Goal[];
    const container=$('goal-list');container.replaceChildren();
    if(!goals.length)container.textContent='No autonomous goals yet.';
    for(const goal of goals){
      const item=document.createElement('div');item.className='goal-entry';
      const head=document.createElement('strong');head.textContent=`${goal.title} — ${goal.state}`;
      const details=document.createElement('small');details.textContent=`Priority ${goal.priority} · ${goal.id.slice(0,8)}`;
      item.append(head,details);
      if(goal.task_id){const open=document.createElement('button');open.type='button';open.textContent='View task';open.onclick=()=>{setFollowLive(false);void loadTask(goal.task_id!)};item.append(open)}
      if(goal.state==='pending'||goal.state==='interrupted'){
        const btn=document.createElement('button');btn.type='button';btn.textContent='Cancel';btn.onclick=async()=>{
          try{await apiJSON(`/api/goals/${goal.id}/cancel`,{method:'POST'});await refreshGoals()}catch(e){$('goal-feedback').textContent=String(e)}
        };item.append(btn);
      }
      if(goal.state==='failed'||goal.state==='interrupted'){
        const btn=document.createElement('button');btn.type='button';btn.textContent='Retry';btn.onclick=async()=>{
          try{await apiJSON(`/api/goals/${goal.id}/retry`,{method:'POST'});await refreshGoals()}catch(e){$('goal-feedback').textContent=String(e)}
        };item.append(btn);
      }
      container.append(item);
    }
  }catch(e){$('autonomy-status').textContent='Unavailable';$('goal-feedback').textContent=String(e)}
}
$('autonomy-toggle').addEventListener('click',async()=>{
  try{await apiJSON('/api/autonomy',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:!autonomyEnabled})});await refreshGoals()}
  catch(e){$('goal-feedback').textContent=String(e)}
});
$('goals-refresh').addEventListener('click',()=>void refreshGoals());
$('goal-form').addEventListener('submit',async e=>{
  e.preventDefault();
  try{
    const title=($('goal-title') as HTMLInputElement).value.trim();
    const prompt=($('goal-prompt') as HTMLTextAreaElement).value.trim();
    const priority=Number(($('goal-priority') as HTMLInputElement).value);
    await apiJSON('/api/goals',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title,prompt,priority})});
    ($('goal-title') as HTMLInputElement).value='';($('goal-prompt') as HTMLTextAreaElement).value='';
    $('goal-feedback').textContent='Goal added to persistent queue.';
    await refreshGoals();
  }catch(e){$('goal-feedback').textContent=String(e)}
});
void refreshGoals();
setInterval(()=>void refreshGoals(),5000);

// Phase 3.1: inspect and explicitly approve read-only discovery candidates.
type DiscoveryRecord={id:string;project:string;path:string;line:number;note:string;rationale:string;state:string;goal_id:string|null};
async function refreshDiscoveries(){
  try{
    const records=await apiJSON('/api/discoveries') as DiscoveryRecord[];
    const panel=$('discovery-list');panel.replaceChildren();
    if(!records.length)panel.textContent='No TODO/FIXME findings. “Formulate goal” appears on each finding after a scan discovers one. Add a TODO in a VM project or point discovery at a project containing markers.';
    for(const item of records){
      const element=document.createElement('div');element.className='goal-entry';
      const name=document.createElement('strong');name.textContent=`${item.project}/${item.path}:${item.line}`;
      const details=document.createElement('p');details.textContent=`${item.note} — ${item.state}`;
      element.append(name,details);
      if(item.state==='proposed'||item.state==='deferred'){
        for(const action of ['approve','defer','dismiss']){
          const button=document.createElement('button');button.type='button';button.textContent=action;
          button.onclick=async()=>{
            try{await apiJSON(`/api/discoveries/${encodeURIComponent(item.id)}/${action}`,{method:'POST'});await refreshDiscoveries();await refreshGoals()}
            catch(err){$('discovery-status').textContent=String(err)}
          };
          element.append(button);
        }
      }
      if(item.state==='proposed'||item.state==='deferred'){
        const propose=document.createElement('button');propose.type='button';propose.textContent='Formulate goal';
        propose.onclick=async()=>{propose.disabled=true;$('formulation-feedback').textContent='Hermes is formulating...';
          try{await apiJSON(`/api/formulations/from-discovery/${encodeURIComponent(item.id)}`,{method:'POST'});$('formulation-feedback').textContent='Proposal saved.';await refreshFormulations()}
          catch(e){$('formulation-feedback').textContent=String(e)}finally{propose.disabled=false}};
        element.append(propose);
      }
      panel.append(element);
    }
  }catch(err){$('discovery-status').textContent=String(err)}
}
$('discovery-scan').addEventListener('click',async()=>{
  $('discovery-status').textContent='Scanning VM projects...';
  try{
    const result=await apiJSON('/api/discoveries/scan',{method:'POST'}) as {found:number;new:number};
    $('discovery-status').textContent=`Found ${result.found} markers, added ${result.new} proposals.`;
    await refreshDiscoveries();
  }catch(err){$('discovery-status').textContent=String(err)}
});
$('discovery-refresh').addEventListener('click',()=>void refreshDiscoveries());
void refreshDiscoveries();

// Phase 3.2: explicitly opt-in, event-driven read-only discovery decisions.
let decisionsEnabled=false;
async function refreshDecisions(){
 try{
  const cfg=await apiJSON('/api/decisions');decisionsEnabled=cfg.enabled;
  $('decision-state').textContent=cfg.enabled?'SCHEDULED':'PAUSED';
  $('decision-toggle').textContent=cfg.enabled?'Pause discovery':'Enable scheduled discovery';
  if(document.activeElement!==$('decision-interval'))($('decision-interval') as HTMLInputElement).value=String(cfg.scan_interval_seconds);
  if(cfg.last_error)$('decision-feedback').textContent=cfg.last_error;
  const records=await apiJSON('/api/curiosity') as Array<{id:string;question:string;category:string;state:string;priority:number}>;
  const list=$('curiosity-list');list.replaceChildren();
  if(!records.length)list.textContent='No research questions discovered yet.';
  for(const item of records){
   const row=document.createElement('div');row.className='goal-entry';
   const label=document.createElement('p');label.textContent=`${item.question} — ${item.state} (priority ${item.priority})`;
   row.append(label);
   if(item.state!=='dismissed')for(const state of ['open','deferred','dismissed']){
    const btn=document.createElement('button');btn.type='button';btn.textContent=state;
    btn.onclick=async()=>{try{await apiJSON(`/api/curiosity/${encodeURIComponent(item.id)}/${state}`,{method:'POST'});await refreshDecisions()}catch(e){$('decision-feedback').textContent=String(e)}};
    row.append(btn)
   }
   list.append(row);
  }
 }catch(e){$('decision-feedback').textContent=String(e)}
}
$('decision-toggle').addEventListener('click',async()=>{
 try{const seconds=Number(($('decision-interval') as HTMLInputElement).value);
  await apiJSON('/api/decisions',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:!decisionsEnabled,scan_interval_seconds:seconds})});await refreshDecisions()
 }catch(e){$('decision-feedback').textContent=String(e)}
});
$('decision-scan').addEventListener('click',async()=>{
 $('decision-feedback').textContent='Running discovery decision…';
 try{const result=await apiJSON('/api/decisions/scan',{method:'POST'});
  $('decision-feedback').textContent=JSON.stringify(result);await refreshDecisions();await refreshDiscoveries()
 }catch(e){$('decision-feedback').textContent=String(e)}
});
void refreshDecisions();setInterval(()=>void refreshDecisions(),15000);

// Phase 3.3: proposals grounded in discovered findings. Explicit approval only.
type FormulationRecord={id:string;title:string;action:string;rationale:string;acceptance:string;prompt:string;priority:number;state:string;goal_id:string|null};
async function refreshFormulations(){
 try{
  const records=await apiJSON('/api/formulations') as FormulationRecord[];
  const list=$('formulation-list');list.replaceChildren();
  if(!records.length)list.textContent='No formulated goals yet. Use Formulate goal on a discovery.';
  for(const item of records){
   const box=document.createElement('div');box.className='goal-entry';
   const heading=document.createElement('strong');heading.textContent=`${item.title} — ${item.state}`;
   const action=document.createElement('p');action.textContent=`Recommended: ${item.action} · Priority: ${item.priority}`;
   const rationale=document.createElement('p');rationale.textContent=item.rationale;
   const criteria=document.createElement('p');
   try{criteria.textContent='Acceptance: '+(JSON.parse(item.acceptance) as string[]).join('; ')}catch{criteria.textContent='Acceptance criteria unavailable'}
   box.append(heading,action,rationale,criteria);
   if(item.state==='proposed'||item.state==='deferred')for(const choice of ['approve','defer','dismiss']){
    const button=document.createElement('button');button.type='button';button.textContent=choice;
    button.onclick=async()=>{try{await apiJSON(`/api/formulations/${encodeURIComponent(item.id)}/${choice}`,{method:'POST'});await refreshFormulations();await refreshGoals()}
      catch(err){$('formulation-feedback').textContent=String(err)}};box.append(button)
   }
   if(item.goal_id){const button=document.createElement('button');button.type='button';button.textContent='View goals';button.onclick=()=>void refreshGoals();box.append(button)}
   list.append(box);
  }
 }catch(e){$('formulation-feedback').textContent=String(e)}
}
$('formulations-refresh').addEventListener('click',()=>void refreshFormulations());
void refreshFormulations();

// Phase 3.4: plans from completed, approved, read-only investigations.
type PlanRecord={id:string;formulation_id:string;task_id:string;report:string;created_at:string};
async function refreshPlans(){
 try {
  const [plans, formulations, goals]=await Promise.all([
   apiJSON('/api/investigation-plans') as Promise<PlanRecord[]>,
   apiJSON('/api/formulations') as Promise<FormulationRecord[]>,
   apiJSON('/api/goals') as Promise<Array<{id:string;state:string}>>
  ]);
  const container=$('plans-list');container.replaceChildren();
  const saved=new Set(plans.map(x=>x.formulation_id));
  for(const f of formulations){
   if(f.state!=='approved'||!f.goal_id||saved.has(f.id))continue;
   const goal=goals.find(g=>g.id===f.goal_id);
   if(goal?.state!=='completed')continue;
   const box=document.createElement('div');box.className='goal-entry';
   const name=document.createElement('strong');name.textContent=f.title;
   const button=document.createElement('button');button.type='button';button.textContent='Create evidence-backed plan';
   button.onclick=async()=>{button.disabled=true;$('plans-feedback').textContent='Hermes is preparing a plan…';
    try{await apiJSON(`/api/investigation-plans/from-formulation/${encodeURIComponent(f.id)}`,{method:'POST'});$('plans-feedback').textContent='Plan saved for review.';await refreshPlans()}
    catch(err){$('plans-feedback').textContent=String(err)}finally{button.disabled=false}};
   box.append(name,button);container.append(box);
  }
  for(const p of plans){
   const box=document.createElement('details');box.className='goal-entry';
   const title=document.createElement('summary');title.textContent=`Plan for ${formulations.find(f=>f.id===p.formulation_id)?.title||p.formulation_id}`;
   box.append(title);
   try{
    const report=JSON.parse(p.report) as Record<string,unknown>;
    const intro=document.createElement('p');intro.textContent=String(report.summary||'');box.append(intro);
    for(const field of ['evidence','unknowns','steps','acceptance_criteria','risks']){
     const heading=document.createElement('h3');heading.textContent=field.replaceAll('_',' ');box.append(heading);
     const list=document.createElement('ol');
     for(const item of (Array.isArray(report[field])?report[field] as string[]:[])){
      const li=document.createElement('li');li.textContent=item;list.append(li)
     }box.append(list)
    }
   }catch{const bad=document.createElement('p');bad.textContent='Stored report is unreadable';box.append(bad)}
   container.append(box)
  }
  if(!container.children.length)container.textContent='No completed approved investigations or saved plans yet.';
 }catch(err){$('plans-feedback').textContent=String(err)}
}
$('plans-refresh').addEventListener('click',()=>void refreshPlans());
void refreshPlans();
