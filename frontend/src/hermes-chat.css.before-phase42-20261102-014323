#hermes-chat-root{position:fixed;z-index:9999;right:20px;bottom:20px;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#18212f}#hc-toggle{background:#147efb;color:white;border:0;border-radius:999px;padding:13px 20px;font-weight:700;box-shadow:0 10px 35px #0005;cursor:pointer}#hc-panel{position:absolute;right:0;bottom:60px;width:min(440px,calc(100vw - 24px));height:min(720px,calc(100dvh - 88px));background:#f9fafc;border:1px solid #d2d8e0;border-radius:22px;box-shadow:0 18px 55px #0008;overflow:hidden;display:flex;flex-direction:column}#hc-panel[hidden],#hc-events[hidden],#hc-threads[hidden],#hc-progress[hidden]{display:none!important}.hc-head{display:flex;align-items:center;justify-content:space-between;background:#fff;padding:14px 16px;border-bottom:1px solid #ddd;flex-shrink:0}.hc-head strong{display:block;font-size:16px}.hc-head small{display:block;font-size:11px;color:#738192}.hc-actions{display:flex;gap:5px}.hc-actions button{border:0;background:#edf1f7;border-radius:9px;width:32px;height:32px;color:#293342;cursor:pointer;font-size:20px}#hc-threads{max-height:190px;overflow:auto;background:#fff;padding:8px;display:flex;flex-direction:column;border-bottom:1px solid #ddd}#hc-threads button{text-align:left;border:0;padding:9px;background:transparent;color:#26374c;cursor:pointer;border-radius:8px}#hc-threads button:hover{background:#eaf3ff}#hc-messages{flex:1;min-height:0;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:13px;scroll-behavior:smooth}.hc-empty{margin:auto;text-align:center;color:#8b98aa;line-height:1.65}.hc-bubble{max-width:88%;min-width:0;display:flex;flex-direction:column;gap:4px}.hc-bubble.user{align-self:flex-end;align-items:flex-end}.hc-bubble.assistant{align-self:flex-start;align-items:flex-start}.hc-body{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.45;font-size:14px;border-radius:19px;padding:10px 14px;background:#e6e9ef;color:#1d2632}.hc-bubble.user .hc-body{background:#147efb;color:white;border-bottom-right-radius:5px}.hc-bubble.assistant .hc-body{border-bottom-left-radius:5px}.hc-bubble small{font-size:10px;color:#8996a6;padding:0 5px}.hc-bubble-actions{display:flex;gap:7px;opacity:.7}.hc-bubble:hover .hc-bubble-actions,.hc-bubble:focus-within .hc-bubble-actions{opacity:1}.hc-bubble-actions button{font-size:11px;border:0;background:transparent;color:#4774ac;cursor:pointer;padding:2px 4px}#hc-form{display:flex;align-items:flex-end;padding:11px;gap:8px;background:#fff;border-top:1px solid #dfe3e8;flex-shrink:0}#hc-input{background:#f3f5f9;color:#1c2938;border:1px solid #d5dae1;border-radius:19px;padding:11px 13px;resize:vertical;max-height:160px;min-height:43px;flex:1;font:14px system-ui}#hc-send{border:0;border-radius:50%;background:#147efb;color:white;width:40px;height:40px;cursor:pointer;flex-shrink:0}#hc-send:disabled{opacity:.4;cursor:not-allowed}#hc-progress{padding:8px 14px;background:#eaf3ff;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#31577f}#hc-details{background:none;border:0;color:#176bb8;cursor:pointer}#hc-events{height:125px;overflow:auto;background:#101f31;color:#acc4da;font:11px ui-monospace,monospace;padding:8px}#hc-events div{padding:3px 0;border-bottom:1px solid #ffffff12}#hc-feedback{color:#af394b;font-size:12px;padding:0 12px}#hc-feedback:empty{display:none}@media(max-width:520px){#hermes-chat-root{right:8px;bottom:8px}#hc-panel{bottom:52px;width:calc(100vw - 16px);height:calc(100dvh - 72px);border-radius:15px}}
