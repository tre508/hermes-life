        g.fillStyle(0x354e5b);g.fillRect(r.x+116,r.y+77,38,19);
        g.fillStyle(0x8be0bb);g.fillRect(r.x+122,r.y+82,23,3);
        g.fillStyle(0x303943);g.fillRect(r.x+105,r.y+125,48,13);
      }
      this.add.text(r.x+117,r.y+151,r.label,{fontFamily:'monospace',fontSize:'11px',fontStyle:'bold',color:'#f9ead3',backgroundColor:'#263643',padding:{x:6,y:2}}).setOrigin(.5);
      const zone=this.add.zone(r.x+117,r.y+86,235,172).setInteractive({useHandCursor:true});
      zone.on('pointerdown',()=>openRoomDetails(r.id));
    }
    this.input.on('pointerdown',(pointer:Phaser.Input.Pointer)=>{
      const selected=mapRooms.find(r=>pointer.worldX>=r.x && pointer.worldX<=r.x+235 && pointer.worldY>=r.y && pointer.worldY<=r.y+172);
      if(selected) openRoomDetails(selected.id);
    });
    this.roomHighlight=this.add.graphics().setDepth(4);
