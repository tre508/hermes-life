    g.fillStyle(0xb59a75);g.fillRect(0,195,800,14);
    for(const r of mapRooms){
      const cx=r.x+117;
      g.fillStyle(0x8c765e);
      if(r.y<100)g.fillRect(cx-13,175,26,22);
      else g.fillRect(cx-13,205,26,22);
    }
    for(let x=9;x<800;x+=34){g.fillStyle(0xcfb28c,.22);g.fillRect(x,201,12,2);}
    const palette:Record<string,number>={control:0x876b5e,library:0x5b726c,workshop:0x537583,archive:0x806b75,laboratory:0x676784,rest:0x768366};
    for(const r of mapRooms){
      const c=palette[r.id];
      // Warm wooden trim, tiled floor, panelled walls and an overhead lamp.
      g.fillStyle(0x302a30);g.fillRoundedRect(r.x,r.y,235,172,5);
      g.fillStyle(c);g.fillRect(r.x+5,r.y+5,225,160);
      g.fillStyle(0xc9b28d);g.fillRect(r.x+7,r.y+12,221,4);g.fillRect(r.x+7,r.y+139,221,3);
      for(let ix=0;ix<5;ix++)for(let iy=0;iy<3;iy++){
        g.fillStyle((ix+iy)%2===0?0xffffff:0x101820,(ix+iy)%2===0?.045:.04);
        g.fillRect(r.x+10+ix*43,r.y+46+iy*30,40,27);
      }
      // Window and plant give each station a lived-in feeling.
      g.fillStyle(0x283444);g.fillRect(r.x+19,r.y+24,62,43);
      g.fillStyle(0x93b7bd);g.fillRect(r.x+24,r.y+28,52,35);
      g.fillStyle(0x587a89);g.fillRect(r.x+47,r.y+28,4,35);
      g.fillStyle(0x526f54);g.fillRect(r.x+192,r.y+41,8,30);
      g.fillStyle(0x9fbd82);g.fillRect(r.x+184,r.y+32,24,14);g.fillRect(r.x+189,r.y+25,14,18);
      g.fillStyle(0xcab09a);g.fillRect(r.x+180,r.y+70,24,13);
      if(r.id==='rest'){
        g.fillStyle(0xd6a27f);g.fillRect(r.x+88,r.y+92,92,30);g.fillStyle(0x875d60);g.fillRect(r.x+85,r.y+116,98,9);
        g.fillStyle(0xe9caa2);g.fillRect(r.x+105,r.y+98,20,13);
      }else if(r.id==='library'||r.id==='archive'){
        g.fillStyle(0x3d3032);g.fillRect(r.x+93,r.y+26,78,64);
        for(let k=0;k<9;k++){g.fillStyle([0xd3aa7d,0x91b6aa,0xaaa0c9][k%3]);g.fillRect(r.x+98+k*8,r.y+36,5,35);}
        g.fillStyle(0xc2a47e);g.fillRect(r.x+88,r.y+112,84,14);
      }else{
        g.fillStyle(0x5b403b);g.fillRect(r.x+85,r.y+111,101,16);
        g.fillStyle(0x253441);g.fillRect(r.x+105,r.y+65,60,45);
