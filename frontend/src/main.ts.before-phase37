  private animateHero(){
    if(!this.heroGraphic)return;
    this.pulse++;
    const h=this.heroGraphic;h.clear();
    const step=this.walking && this.pulse%2===0?2:0;
    const glow=this.activity==='coding'||this.activity==='evaluating';
    h.fillStyle(0x9fd6d3);h.fillRect(-11,-16+step,22,22);
    h.fillStyle(0x163846);h.fillRect(-8,-11+step,16,12);
    h.fillStyle(glow&&this.pulse%3===0?0xf4d18a:0x8af5b9);
    h.fillRect(-5,-7+step,3,3);h.fillRect(3,-7+step,3,3);
    h.fillStyle(0xa3b8cb);h.fillRect(-11,7+step,22,13);
    h.fillStyle(0x657a91);h.fillRect(-8,20+(this.walking?this.pulse%2*3:0),6,6);
    h.fillRect(2,20+(this.walking?(this.pulse+1)%2*3:0),6,6);
    if(glow){h.fillStyle(0xf5d18a,.7);h.fillRect(13,-12,3,3);}
  }
  private walkNext(){
    const next=this.pendingPath.shift();
    if(!next){this.walking=false;this.motion=undefined;return;}
    const distance=Phaser.Math.Distance.Between(this.hero.x,this.hero.y,next.x,next.y);
    if(distance<2){this.hero.setPosition(next.x,next.y);this.walkNext();return;}
    this.walking=true;
    this.motion=this.tweens.add({targets:this.hero,x:next.x,y:next.y,
      duration:Math.max(120,distance*3),ease:'Linear',onComplete:()=>this.walkNext()});
  }
  moveTo(roomName:string, activity:string, immediate=false){
    if(!(roomName in centers))return;
    const room=roomName as RoomId;
    this.room=room;this.activity=activity;
    const target=mapRooms.find(r=>r.id===room)!;
    this.roomHighlight.clear().lineStyle(3,0xa8e8c5,.95).strokeRoundedRect(target.x+1,target.y+1,233,170,5);
    $('room').textContent=room.toUpperCase();$('activity').textContent=activity;updateStudio(room,activity);
    this.motion?.stop();this.pendingPath=[];
    const to=centers[room];
    if(immediate){this.walking=false;this.hero.setPosition(to.x,to.y);return;}
    const fromY=this.hero.y;
    const corridorY=202;
    // Walk via the shared corridor rather than diagonally through furniture.
    this.pendingPath=[new Phaser.Math.Vector2(this.hero.x,corridorY),
      new Phaser.Math.Vector2(to.x,corridorY),new Phaser.Math.Vector2(to.x,to.y)];
    if(Math.abs(fromY-corridorY)<1)this.pendingPath.shift();
    this.walkNext();
  }

}
