// Phase 3: persistent, explicitly approved goals and a backend-owned scheduler.
type Goal = {id:string;title:string;prompt:string;priority:number;state:string;task_id:string|null;error:string|null};
let autonomyEnabled=false;
async function apiJSON(url:string, init?:RequestInit):Promise<any>{
  const response=await fetch(url,init);
  const raw=await response.text();
  let body:any;
  try{body=raw?JSON.parse(raw):null}catch{throw Error(`Invalid API response (HTTP ${response.status})`)}
  if(!response.ok)throw Error(body?.detail||`HTTP ${response.status}`);
  return body;
}
async function refreshGoals(){
  try{
    const state=await apiJSON('/api/autonomy') as {enabled:boolean};autonomyEnabled=state.enabled;
    $('autonomy-status').textContent=autonomyEnabled?'ENABLED':'PAUSED';
    $('overview-autonomy-status').textContent=autonomyEnabled?'ENABLED':'PAUSED';
    $('autonomy-toggle').textContent=autonomyEnabled?'Pause autonomy':'Enable autonomy';
    const goals=await apiJSON('/api/goals') as Goal[];
    const container=$('goal-list');container.replaceChildren();
    if(!goals.length)container.textContent='No autonomous goals yet.';
    // Show pending and active goals first, with a bounded recent-history preview.
    const active=goals.filter(g=>!['completed','cancelled','failed'].includes(g.state));
    const recent=goals.filter(g=>['completed','cancelled','failed'].includes(g.state)).slice(0,5);
    for(const goal of [...active,...recent]){
      const item=document.createElement('div');item.className='goal-entry';
      const head=document.createElement('strong');head.textContent=`${goal.title} — ${goal.state}`;
      const details=document.createElement('small');details.textContent=`Priority ${goal.priority} · ${goal.id.slice(0,8)}`;
      item.append(head,details);
      if(goal.task_id){const open=document.createElement('button');open.type='button';open.textContent='View task';open.onclick=()=>{setFollowLive(false);void loadTask(goal.task_id!)};item.append(open)}
      if(goal.state==='pending'||goal.state==='interrupted'){
        const btn=document.createElement('button');btn.type='button';btn.textContent='Cancel';btn.onclick=async()=>{
          try{await apiJSON(`/api/goals/${goal.id}/cancel`,{method:'POST'});await refreshGoals()}catch(e){$('goal-feedback').textContent=String(e)}
        };item.append(btn);
      }
      if(goal.state==='failed'||goal.state==='interrupted'){
        const btn=document.createElement('button');btn.type='button';btn.textContent='Retry';btn.onclick=async()=>{
          try{await apiJSON(`/api/goals/${goal.id}/retry`,{method:'POST'});await refreshGoals()}catch(e){$('goal-feedback').textContent=String(e)}
        };item.append(btn);
      }
      container.append(item);
    }
    const remaining=goals.length-active.length-recent.length;
    if(remaining>0){const note=document.createElement('p');note.className='hint';note.textContent=`${remaining} older goals not shown. Full results remain available in task history.`;container.append(note)}
  }catch(e){$('autonomy-status').textContent='Unavailable';$('goal-feedback').textContent=String(e)}
}
$('autonomy-toggle').addEventListener('click',async()=>{
