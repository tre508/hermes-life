{
  "name": "hermes-life-world",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:town": "node --import tsx --test tests/town-model.test.ts",
    "test:ui": "node --import tsx --test tests/control-wiring.test.ts",
    "test:renderer": "node --import tsx --test tests/town-renderer.test.ts",
    "test:lifecycle": "node --import tsx --test tests/task-lifecycle.test.ts",
    "test:build": "node --import tsx --test tests/build-inspector.test.ts",
    "test": "npm run test:town && npm run test:ui && npm run test:renderer && npm run test:lifecycle && npm run test:build"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
